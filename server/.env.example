# ==========================================
# CareerPulse ATS Backend Configuration
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# Allowed Frontend URL(s) for CORS (comma-separated if multiple, e.g. 5173, 5174)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# MongoDB Atlas Connection URI (Placeholder - replace with your actual Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careerpulse?retryWrites=true&w=majority

# JWT Authentication (Placeholder - use a secure, randomly generated 256-bit key in production)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ==========================================
# SMTP Email Service Configuration (Gmail / Nodemailer)
# ==========================================
# Configure your Gmail address and 16-character Google App Password (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="CareerPulse ATS" <your_email@gmail.com>
